# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# Comma-separated list of allowed origins for CORS (web + native dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Database (Supabase / PostgreSQL) ─────────────────────
# Pooled connection (use in the app). On Supabase use the "Transaction" pooler URL.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (used by Prisma Migrate only).
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ─── Auth (JWT) ───────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-in-production-access
JWT_REFRESH_SECRET=change-me-in-production-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ─── Integrations (added as features land) ────────────────
# Google Gemini — AI triage (Migo IA)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Google Maps Platform — geolocation
GOOGLE_MAPS_API_KEY=
# Google OAuth — login con Google (Web + Android cliente + Android vet, separados por coma)
GOOGLE_CLIENT_IDS=
# GetStream — chat + video. El SECRET solo vive en el servidor, nunca en el cliente.
STREAM_API_KEY=
STREAM_API_SECRET=
# Agora.io — teleconsult / video
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ─── Business rules ───────────────────────────────────────
# CPL fee charged to a clinic per attended emergency lead (USD)
CPL_FEE_USD=4
# Commission taken on routine bookings paid in-app (fraction)
BOOKING_COMMISSION_RATE=0.09
